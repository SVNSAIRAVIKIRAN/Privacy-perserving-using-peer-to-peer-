# P2P Cloud Auth — Environment Configuration
# Copy this file to .env and adjust values as needed

HUB_PORT=8000
HUB_URL=http://localhost:8000

# Peer presence (seconds)
OFFLINE_THRESHOLD=180
HEARTBEAT_INTERVAL=20

# Session lifetime (seconds) — 3600 = 1 hour
SESSION_TTL=3600

# File storage
MAX_FILE_MB=10
FILES_DIR=./file_store
DB_PATH=./p2p.db

# Security — increase rounds for production (12 is fine for demo)
BCRYPT_ROUNDS=12
